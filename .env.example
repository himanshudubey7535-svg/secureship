# Database
MYSQL_ROOT_PASSWORD=secureship_dev_password
DATABASE_URL=mysql+pymysql://root:secureship_dev_password@localhost:3306/secureship

# JWT (generate a real secret: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# Trivy
TRIVY_TIMEOUT=300

# Browser origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend
VITE_API_URL=http://localhost:8000/api

# Request limits
SCAN_RATE_LIMIT_PER_HOUR=20
MAX_CONCURRENT_SCANS=2
MAX_REQUEST_BYTES=100000
